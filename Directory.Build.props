<Project>

  <!-- Version und Produktangaben zentral, damit sie beim Release nur an einer
       Stelle gepflegt werden müssen. -->
  <PropertyGroup>
    <Version>1.2.0</Version>
    <!-- Nutzersichtbarer Produktname. Namensraum, Assembly- und Repository-Name
         bleiben bewusst bei „VolvoSplitter": v1.0.0 ist mit Release-Artefakten
         veröffentlicht, und eine Umbenennung bräche jede Verknüpfung und jedes
         Nutzerskript — für null Funktionsgewinn. -->
    <Product>Flash File Splitter</Product>
    <Company>ubbg</Company>
    <Copyright>Copyright (c) 2026 ubbg</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
